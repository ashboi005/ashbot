# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# --- Attachments: S3 when S3_BUCKET is set, otherwise local disk (UPLOADS_DIR) ---
# @optional
S3_BUCKET=
# @optional
S3_REGION=
# @optional
S3_ACCESS_KEY_ID=
# @optional
S3_SECRET_ACCESS_KEY=
# @optional @type=url
S3_ENDPOINT=
# @optional @public
UPLOADS_DIR=

# --- Voice notes ---
# @optional
DEEPGRAM_API_KEY=

# --- Merge Gateway (transcript cleanup in the server; investigations in the worker) ---
# @optional
MERGE_GATEWAY_API_KEY=
# @optional @public @type=url
MERGE_GATEWAY_BASE_URL=https://api-gateway.merge.dev/v1
# @optional @public
LLM_MODEL=
# @optional @public
CLEANUP_MODEL=

# --- Worker ---
# @optional
DISCORD_WEBHOOK_URL=
# @optional @public
PROJECTS_FILE=
